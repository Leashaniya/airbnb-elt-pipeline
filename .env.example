# Copy this file to .env and fill in your own values.
# .env is in .gitignore and must never be committed or shared.

# --- AWS (IAM user with S3 access) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Bucket names are globally unique, e.g. airbnb-elt-yourname-2026
S3_BUCKET=

# --- Snowflake ---
# Account identifier, e.g. orgname-accountname
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=AIRBNB_WH
SNOWFLAKE_DATABASE=AIRBNB
